    "tool.checkout": {
      "address": {
        "value": "tool.checkout",
        "span": "tools/checkout.yml:13:1..13:14"
      },
      "span": "tools/checkout.yml:13:1..20:1",
      "namespace": "tool",
      "description": {
        "value": "View and edit files in the repository checkout under review. Paths are relative to the checkout root, and a path that resolves outside it is refused.",
        "span": "tools/checkout.yml:17:5..20:1"
      },
      "input": {
        "surface": "input",
        "fields": [
          {
            "name": {
              "value": "command",
              "span": "tools/checkout.yml:14:3..20:1"
            },
            "type": {
              "description": {
                "value": "The file operation to perform: `view` reads a file or lists a directory, `create` writes a whole file, `str_replace` swaps one occurrence of a string, `insert` adds text at a line.",
                "span": "tools/checkout.yml:14:3..20:1"
              },
              "span": "tools/checkout.yml:14:3..20:1",
              "form": "enum",
              "variants": [
                {
                  "value": "view",
                  "span": "tools/checkout.yml:14:3..20:1"
                },
                {
                  "value": "create",
                  "span": "tools/checkout.yml:14:3..20:1"
                },
                {
                  "value": "str_replace",
                  "span": "tools/checkout.yml:14:3..20:1"
                },
                {
                  "value": "insert",
                  "span": "tools/checkout.yml:14:3..20:1"
                }
              ]
            }
          },
          {
            "name": {
              "value": "path",
              "span": "tools/checkout.yml:14:3..20:1"
            },
            "type": {
              "description": {
                "value": "The file or directory, relative to this tool's workspace.",
                "span": "tools/checkout.yml:14:3..20:1"
              },
              "span": "tools/checkout.yml:14:3..20:1",
              "form": "scalar",
              "type": "string",
              "min_length": 1
            }
          },
          {
            "name": {
              "value": "view_range",
              "span": "tools/checkout.yml:14:3..20:1"
            },
            "type": {
              "description": {
                "value": "The first and last line to show, for `view` of a file: `[10, 40]`. Lines count from 1 and both ends are included; `-1` as the last line reads to the end of the file. Omitted, the whole file is shown.",
                "span": "tools/checkout.yml:14:3..20:1"
              },
              "span": "tools/checkout.yml:14:3..20:1",
              "form": "array",
              "items": {
                "span": "tools/checkout.yml:14:3..20:1",
                "form": "scalar",
                "type": "integer",
                "minimum": -1,
                "maximum": 1000000
              },
              "max_items": 2,
              "default": {
                "value": [],
                "span": "tools/checkout.yml:14:3..20:1"
              }
            }
          },
          {
            "name": {
              "value": "file_text",
              "span": "tools/checkout.yml:14:3..20:1"
            },
            "type": {
              "description": {
                "value": "The whole contents of the file, for `create`.",
                "span": "tools/checkout.yml:14:3..20:1"
              },
              "span": "tools/checkout.yml:14:3..20:1",
              "form": "scalar",
              "type": "string",
              "default": {
                "value": "",
                "span": "tools/checkout.yml:14:3..20:1"
              }
            }
          },
          {
            "name": {
              "value": "old_str",
              "span": "tools/checkout.yml:14:3..20:1"
            },
            "type": {
              "description": {
                "value": "The exact text to replace, for `str_replace`. It must appear exactly once.",
                "span": "tools/checkout.yml:14:3..20:1"
              },
              "span": "tools/checkout.yml:14:3..20:1",
              "form": "scalar",
              "type": "string",
              "default": {
                "value": "",
                "span": "tools/checkout.yml:14:3..20:1"
              }
            }
          },
          {
            "name": {
              "value": "new_str",
              "span": "tools/checkout.yml:14:3..20:1"
            },
            "type": {
              "description": {
                "value": "The text to put in its place, for `str_replace` and `insert`.",
                "span": "tools/checkout.yml:14:3..20:1"
              },
              "span": "tools/checkout.yml:14:3..20:1",
              "form": "scalar",
              "type": "string",
              "default": {
                "value": "",
                "span": "tools/checkout.yml:14:3..20:1"
              }
            }
          },
          {
