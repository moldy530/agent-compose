/target
/.claude/worktrees/

# Where the release pipeline stages what it is about to publish
# (`.github/workflows/release-artifacts.yml`), and where anybody reproducing
# those steps by hand will stage it too. An artifact belongs to a release, never
# to the tree.
/dist/

# The pinned JavaScript toolchain the generated-code gates install, and the
# scratch copies of the golden projects they type-check. `node-fallback/` is the
# second install of the same pins, the npm one gates 13 and 15 run under Node —
# it also holds the staged copies of the runners those gates spawn, so a runner's
# own imports resolve in it rather than in the Bun install. All three are rebuilt
# by `cargo test`; the two lockfiles beside them are committed.
/crates/compose-core/tests/toolchain/node_modules/
/crates/compose-core/tests/toolchain/projects/
/crates/compose-core/tests/toolchain/node-fallback/

# `insta`'s pending snapshots: a failed comparison writes the value it saw
# beside the committed one, for `cargo insta review` to accept or reject. The
# accepted file is what is committed; the pending one is a working note.
*.snap.new
